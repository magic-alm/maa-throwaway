{
  "apiVersion": "magic-alm.auto/v1",
  "kind": "AutoImplementPolicy",
  "metadata": {
    "name": "upfront-plan-review-live-smoke"
  },
  "spec": {
    "intake": {
      "providers": [
        "github"
      ],
      "events": [
        "issue_comment:/auto implement"
      ]
    },
    "context": {
      "provider": "mcp",
      "maxHydratedFiles": 8,
      "maxBytesPerFile": 16000
    },
    "phasing": {
      "enabled": false,
      "maxEstimatedTurnsPerPhase": 8,
      "requireExplicitFileScope": true
    },
    "routing": {
      "triageModel": "small",
      "planningModel": "medium",
      "repairModel": "high",
      "routes": {
        "triage": {
          "primary": {
            "provider": "foundry-anthropic",
            "tier": "small",
            "model": "claude-sonnet-5-5"
          },
          "fallback": []
        },
        "planning": {
          "primary": {
            "provider": "foundry-anthropic",
            "tier": "medium",
            "model": "claude-sonnet-5-5"
          },
          "fallback": []
        },
        "implementation": {
          "primary": {
            "provider": "foundry-anthropic",
            "tier": "high",
            "model": "claude-sonnet-5-5"
          },
          "fallback": []
        },
        "repair": {
          "primary": {
            "provider": "foundry-anthropic",
            "tier": "high",
            "model": "claude-sonnet-5-5"
          },
          "fallback": []
        },
        "finalize": {
          "primary": {
            "provider": "foundry-anthropic",
            "tier": "small",
            "model": "claude-sonnet-5-5"
          },
          "fallback": []
        }
      }
    },
    "verification": {
      "commands": [
        "npm test"
      ],
      "requireAllPass": true,
      "stopConditions": [
        {
          "kind": "maxTurnsExceeded",
          "threshold": 8,
          "action": "abort",
          "message": "Stop because turn budget is exhausted."
        }
      ]
    },
    "guardrails": {
      "maxFilesChanged": 1,
      "maxDiffLines": 200,
      "requireDeclaredDependencies": true,
      "requireTsconfigValidPaths": false,
      "forbidPaths": [
        ".github/workflows/**",
        ".github/maa-policy.json"
      ]
    },
    "approvals": {
      "requireHumanReviewAboveSeverity": "P1"
    },
    "planReview": {
      "required": true,
      "maxPasses": 3,
      "checks": [
        {
          "id": "slug-regression",
          "command": "npm test",
          "validatorPaths": [
            "tests/slug.test.js",
            "package.json"
          ],
          "producedPaths": []
        }
      ]
    }
  }
}
